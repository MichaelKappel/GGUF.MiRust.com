handoff_root: agent-file-handoff/
active_buckets:
  content: agent-file-handoff/Content/
  improvement: agent-file-handoff/Improvement/
forbidden_default_bucket:
  archive: agent-file-handoff/Archive/
completion_gate:
  required_before_broad_work: true
  live_scan_required: true
  ledger_path: .uai/intake-outcome-ledger.uai
  outcomes:
    - incorporated
    - rejected-with-reason
    - preserved-to-durable-memory
    - kept-active-with-reason
